# syntax=docker/dockerfile:1.7
# Runtime image built from a pre-compiled cascadr binary — no source, no toolchain.
#
# CI (.github/workflows/release.yml) extracts each release tarball into
# dist/linux/<arch>/cascadr and builds this with `buildx --platform
# linux/amd64,linux/arm64`; buildx selects the matching binary per platform via
# $TARGETARCH, producing a multi-arch manifest with no QEMU emulation.
#
# Manual single-arch build:
#   mkdir -p dist/linux/amd64
#   tar -xzf cascadr-x86_64-unknown-linux-gnu.tar.gz -C dist/linux/amd64/
#   docker build -f Dockerfile.dist -t cascadr .
#
# ubuntu:24.04 matches the release builder (ubuntu-latest, glibc 2.39) and ships
# libgcc-s1 by default; the binary is OpenSSL-free (rustls), so only
# ca-certificates is needed for outbound TLS. curl is installed because the
# openai-compat rung shells out to it (no native HTTP client in the dependency
# tree) — without it that rung, the only one reachable in this image, cannot
# run regardless of LLM_OPENAI_COMPAT_URL (cascadr#26). That URL must be https
# (http is allowed only to this CONTAINER's own loopback, never the host's) —
# `claude` for the subscription rung isn't in this image at all; add it in a
# derived image to use that rung here.
FROM ubuntu:24.04@sha256:786a8b558f7be160c6c8c4a54f9a57274f3b4fb1491cf65146521ae77ff1dc54

LABEL org.opencontainers.image.source="https://github.com/Barnett-Studios/cascadr" \
      org.opencontainers.image.description="Cost-ordered fail-open LLM provider cascade" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0"

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home --user-group cascadr

# Populated by CI (or a manual tar extraction) before build; buildx sets TARGETARCH.
ARG TARGETARCH
COPY --chmod=755 dist/linux/${TARGETARCH}/cascadr /usr/local/bin/cascadr

USER 10001
WORKDIR /repo
ENTRYPOINT ["cascadr"]
